# Omit DATABASE_URL to use backend/jobpilot.db consistently from any working directory.
# DATABASE_URL=sqlite:////absolute/path/to/jobpilot.db
JOB_COLLECTION_INTERVAL_MINUTES=60
SCHEDULER_POLL_SECONDS=30
SCHEDULER_BATCH_SIZE=5
SCHEDULER_LEASE_MINUTES=15
LINKEDIN_ENRICHMENT_BATCH_SIZE=25
SECRET_KEY=change-this-secret-in-production
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# auto uses Firecrawl if FIRECRAWL_API_KEY is set, then Brave if BRAVE_SEARCH_API_KEY is set,
# then falls back to the local HTML search parser.
WEB_SEARCH_PROVIDER=auto
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=
